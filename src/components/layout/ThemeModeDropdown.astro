---
import { cn } from '@/lib/cn';
import { t, getLocaleFromPath } from '@/i18n';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
const lightName = t('theme.light', locale);
const darkName = t('theme.dark', locale);
---

<div class={cn('relative ttg-wrapper', className)}>
  <button
    type="button"
    class={cn(
      'ttg-trigger inline-flex items-center justify-center rounded-full border border-border-strong p-1.5',
      'text-foreground-muted hover:text-foreground hover:bg-secondary',
      'transition-colors duration-(--transition-fast)',
      'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2'
    )}
    aria-label={t('theme.colourMode', locale)}
    title={t('theme.colourMode', locale)}
    data-i18n-template={t('theme.modeTrigger', locale)}
    data-i18n-light={lightName}
    data-i18n-dark={darkName}
  >
    <svg class="ttg-icon ttg-icon-light h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
    </svg>
    <svg class="ttg-icon ttg-icon-dark h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
    </svg>
  </button>
</div>

<style>
  .ttg-trigger .ttg-icon { display: none; }
  :global(html:not(.dark)) .ttg-trigger .ttg-icon-light,
  :global(html.dark) .ttg-trigger .ttg-icon-dark {
    display: block;
  }
</style>

<script>
  type Mode = 'system' | 'light' | 'dark';

  const STORAGE_KEY = 'theme';

  function readMode(): Mode {
    try {
      const mode = localStorage.getItem(STORAGE_KEY);
      if (mode === 'system' || mode === 'light' || mode === 'dark') return mode;
    } catch { /* private mode */ }
    return 'system';
  }

  function applyMode(mode: Mode): void {
    const root = document.documentElement;
    root.setAttribute('data-theme-mode', mode);
    const isDark = mode === 'dark' ||
      (mode === 'system' &&
        typeof window.matchMedia === 'function' &&
        window.matchMedia('(prefers-color-scheme: dark)').matches);
    root.classList.toggle('dark', isDark);
  }

  function syncTriggerLabels(): void {
    const nextMode = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
    document.querySelectorAll<HTMLButtonElement>('.ttg-trigger').forEach((button) => {
      const template = button.dataset.i18nTemplate ?? 'Switch to {mode} mode.';
      const name = button.dataset[nextMode === 'light' ? 'i18nLight' : 'i18nDark'] ?? nextMode;
      const label = template.replace('{mode}', name.toLowerCase());
      button.setAttribute('aria-label', label);
      button.setAttribute('title', label);
    });
  }

  function closeColourThemePanel(): void {
    document.getElementById('theme-dropdown-panel')?.classList.add('hidden');
    const trigger = document.getElementById('theme-dropdown-trigger');
    if (trigger) {
      trigger.setAttribute('aria-expanded', 'false');
      trigger.querySelector('.theme-chevron')?.classList.remove('rotate-180');
    }
  }

  function initThemeMode(): void {
    const wrappers = document.querySelectorAll<HTMLElement>('.ttg-wrapper');
    if (!wrappers.length) return;

    syncTriggerLabels();

    wrappers.forEach((wrapper) => {
      if (wrapper.dataset.ttgInit) return;
      wrapper.dataset.ttgInit = 'true';

      const trigger = wrapper.querySelector<HTMLButtonElement>('.ttg-trigger');
      if (!trigger) return;

      trigger.addEventListener('click', () => {
        const nextMode = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
        try { localStorage.setItem(STORAGE_KEY, nextMode); } catch { /* private mode */ }
        applyMode(nextMode);
        syncTriggerLabels();
        closeColourThemePanel();
      });
    });

    if (!(window as unknown as { __ttgGlobalInit?: boolean }).__ttgGlobalInit) {
      (window as unknown as { __ttgGlobalInit?: boolean }).__ttgGlobalInit = true;

      if (typeof window.matchMedia === 'function') {
        const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
        const onSchemeChange = () => {
          if (document.documentElement.getAttribute('data-theme-mode') === 'system') {
            syncTriggerLabels();
          }
        };
        if (mediaQuery.addEventListener) mediaQuery.addEventListener('change', onSchemeChange);
        else if (mediaQuery.addListener) mediaQuery.addListener(onSchemeChange);
      }
    }
  }

  initThemeMode();
  document.addEventListener('astro:page-load', initThemeMode);
  document.addEventListener('astro:after-swap', initThemeMode);
</script>
